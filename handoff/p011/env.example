# Names / purposes / issuance locations only. No actual credentials.
# Vercel target project > Settings > Environment Variables:
PUBLIC_ORIGIN= # Exact new website HTTPS origin; current origin events.seoularena.net
ADMIN_WORKER_URL= # New authenticated Admin Worker URL
PUBLIC_WORKER_URL= # New authenticated Public Worker URL
SESSION_SECRET= # Generate fresh cryptographically random session signing secret for new environment
GATEWAY_SECRET= # Generate fresh secret shared with target Admin and Public Workers
GOOGLE_CLIENT_ID= # Company Google Cloud Console OAuth web client; preserve existing SSO untouched
GOOGLE_CLIENT_SECRET= # Google Cloud project owner supplies via secret store
# Admin Worker > Secrets:
PII_PRIVATE_KEY= # EXISTING RSA PKCS8 DER base64 private key from original secure key custodian; cannot recover from Worker Secrets API
IDENTITY_HMAC_KEY= # EXISTING deduplication key shared with Public Worker; preserve to match stored identities
# Public Worker > Secrets:
PII_PUBLIC_KEY= # Matching existing RSA SPKI DER base64 public key, original key custodian
TURNSTILE_SECRET= # Cloudflare dashboard > Turnstile widget for intended host
# Public Worker also uses IDENTITY_HMAC_KEY and GATEWAY_SECRET. Admin uses GATEWAY_SECRET.
# Worker vars (not secret):
ENVIRONMENT= # production on new production workers; local only for isolated synthetic tests
PII_KEY_VERSION= # events-v1 for existing ciphertext; do not arbitrarily change
TURNSTILE_SITE_KEY= # Public key from corresponding Cloudflare Turnstile widget
# Data Worker DB binding -> NEW D1. Admin/Public DATA binding -> NEW Data Worker correct RPC entrypoint.
# 15-minute Data cron: review retention policy before enabling on copied production data.
# Never use scripts/events-dev-keys.mjs to replace keys for existing production ciphertext.
